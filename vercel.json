{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "create-react-app"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/$1" }
  ],
  "env": {
    "APP_NAME": "CyberShield",
    "APP_PUBLIC_URL": "https://cyber-shield.vercel.app"
  }
}
